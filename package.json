{
    "name": "@gtindependence/typedi-common",
    "version": "4.1.1",
    "description": "Our common services, providers, etc for TypeDI projects",
    "keywords": [
        "Typescript",
        "TypeDI",
        "Seed"
    ],
    "main": "index.js",
    "typings": "index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "modules/**/*.js",
        "modules/**/*.d.ts"
    ],
    "author": "TeamHive, GTIndependence",
    "contributors": [
        "John Pinkster <jpinkster>",
        "Tyler Vander Maas <tvmaasjazz>"
    ],
    "license": "ISC",
    "homepage": "https://github.com/TeamHive/typedi-common",
    "repository": {
        "type": "git",
        "url": "https://github.com/TeamHive/typedi-common.git"
    },
    "bugs": {
        "url": "https://github.com/TeamHive/typedi-common/issues"
    },
    "scripts": {
        "clean": "rm -f *.js && rm -f *.d.ts && rm -Rf modules",
        "test": "echo \"Error: no test specified\" && exit 1",
        "watch": "tsc -w",
        "build": "npm run clean && tsc",
        "prepack": "npm run lint && npm run build",
        "postpublish": "git push && git push --tags",
        "postpack": "npm run clean",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --check src"
    },
    "peerDependencies": {
        "@sentry/node": "^11.8.0",
        "@types/config": "^3.3.2",
        "config": "^3.3.9",
        "js-yaml": "^4.3.2",
        "log4js": "^6.9.1",
        "reflect-metadata": "~0.1.13",
        "typedi": "^0.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sentry/node": "^11.8.0",
        "@types/config": "^3.3.2",
        "@types/node": "24.19.2",
        "config": "^3.3.9",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-node": "^0.4.0",
        "eslint-plugin-import-x": "^4.17.1",
        "js-yaml": "^4.3.2",
        "log4js": "^6.9.1",
        "prettier": "^3.8.1",
        "reflect-metadata": "~0.1.13",
        "typedi": "^0.10.0",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.72.0"
    }
}
